# Python
__pycache__/
*.py[cod]
.Python
venv/
.venv/
env/
*.egg-info/
.pytest_cache/

# Experiment output — regenerated by scripts, never committed (RP-06, RP-07).
# Raw logs are preserved on disk untouched before aggregation (T8.7), but the
# repository tracks the code that produces them, not the results themselves.
logs/*
!logs/.gitkeep
plots/*
!plots/.gitkeep

# Wireshark captures: large binaries. The curated evidence set for T9.4 is
# committed deliberately by force-adding the specific files.
captures/*
!captures/.gitkeep
*.pcap
*.pcapng

# Transfer artifacts
received_*
*.received

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
